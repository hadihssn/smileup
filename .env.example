# Copy this file to .env.local and fill in real values from the Neon dashboard.
# .env.local is gitignored — never commit real secrets.

# Neon Postgres connection string (Dashboard → Connection Details)
DATABASE_URL=

# Neon Auth (Stack Auth) — Dashboard → Auth tab setup snippet
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=
