# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Neon Postgres connection string (Dashboard → Connection Details)
DATABASE_URL=

# Neon Auth ("Managed Better Auth") — Dashboard → Project → Branch → Auth →
# click "Enable Auth" → Configuration tab → copy the Auth URL
NEON_AUTH_BASE_URL=

# Not from the dashboard — generate locally with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
